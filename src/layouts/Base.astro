---
import { url, absoluteUrl } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}
const SITE_NAME = 'Mon adresse en données';
const {
  title,
  description = 'Tapez une adresse en France : risques, eau du robinet, air, bruit, fibre, réseau mobile, prix de l’immobilier, écoles et santé, avec la source de chaque chiffre.',
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
// Directory-style URLs, as GitHub Pages serves them. Address sheets live in the #fragment,
// so they all share the home page's canonical URL and are never indexed, on purpose.
const canonical = absoluteUrl(Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length).replace(/\/?$/, '/'));
const image = absoluteUrl('/og.png');

// Self-hosted fonts (SIL OFL, see public/fonts/LICENSE.md), latin + latin-ext subsets.
const font = (file: string) => url(`/fonts/${file}`);
const LATIN_EXT = 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF';
const LATIN = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const face = (family: string, style: string, weight: string, ext: string, lat: string) => `
  @font-face { font-family: '${family}'; font-style: ${style}; font-weight: ${weight}; font-display: swap; src: url(${font(ext)}) format('woff2'); unicode-range: ${LATIN_EXT}; }
  @font-face { font-family: '${family}'; font-style: ${style}; font-weight: ${weight}; font-display: swap; src: url(${font(lat)}) format('woff2'); unicode-range: ${LATIN}; }`;
const fontCss = [
  face('Cormorant Garamond', 'normal', '400 700', 'cormorant-garamond-normal-400-latin-ext.woff2', 'cormorant-garamond-normal-400-latin.woff2'),
  face('Cormorant Garamond', 'italic', '400 700', 'cormorant-garamond-italic-400-latin-ext.woff2', 'cormorant-garamond-italic-400-latin.woff2'),
  face('Schibsted Grotesk', 'normal', '400 800', 'schibsted-grotesk-latin-ext.woff2', 'schibsted-grotesk-latin.woff2'),
].join('\n');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mon adresse en données : les données publiques sur votre adresse, avec leurs sources." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={font('cormorant-garamond-normal-400-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <style set:html={fontCss}></style>
    <!-- GoatCounter: no cookie; it counts the path only, never the #fragment that holds the place. -->
    {import.meta.env.PROD && <script is:inline data-goatcounter="https://arimet.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>}
  </head>
  <body>
    <header class="site">
      <a href={url('/')} class="brand">Mon adresse en données</a>
      <a href={url('/sources/')}>Sources et méthodologie</a>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  /* Light editorial map UI. The map is the stage; text sits on white veils over it.
     One accent (orange) for the route and actions, one secondary (teal) for numbered places.
     Radii: stage 14px, cards 10px, controls 8px. */
  :root {
    --bg: #eef0ee;
    --paper: #ffffff;
    --ink: #1f2324;
    --muted: #5d6466;       /* 6:1 on white */
    --line: #dde1e0;
    --orange: #e8702a;      /* route, markers, recentre button (non-text) */
    --orange-ink: #b04f14;  /* orange text: 5.3:1 on white */
    --teal: #1f7466;        /* numbered badges, white text 5.6:1 */
    --serif: 'Cormorant Garamond', 'Iowan Old Style', Georgia, serif;
    --sans: 'Schibsted Grotesk', 'Helvetica Neue', Arial, system-ui, sans-serif;
    --header-h: 4rem;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 1rem/1.55 var(--sans); }
  a { color: var(--ink); }
  :focus-visible { outline: 3px solid var(--orange-ink); outline-offset: 2px; }
  [hidden] { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  header.site { height: var(--header-h); padding: 0 1.25rem; max-width: 90rem; margin: 0 auto; display: flex; gap: 0.5rem 2rem; justify-content: space-between; align-items: center; }
  .brand { font: 600 1.6rem/1 var(--serif); text-decoration: none; letter-spacing: 0.01em; }
  header.site a:not(.brand) { font-variant: small-caps; letter-spacing: 0.06em; font-weight: 600; text-decoration: none; font-size: 1.05rem; }
  header.site a:not(.brand):hover { text-decoration: underline; }
  main { padding: 0 1.25rem 5rem; max-width: 90rem; margin: 0 auto; }
  /* Home: the stage is the whole page, no scroll. */
  main:has(> #search:not([hidden])) { padding-bottom: 1rem; }

  .kicker { font-variant: small-caps; letter-spacing: 0.08em; color: var(--muted); font-weight: 600; margin: 0 0 0.6rem; }
  .kicker a { color: var(--muted); text-decoration: none; }
  .kicker a:hover { color: var(--ink); text-decoration: underline; }
  .display { font: 600 clamp(2.2rem, 4.4vw, 3.6rem)/1.02 var(--serif); letter-spacing: -0.01em; margin: 0 0 1rem; }
  .lede { color: var(--muted); font-size: 1.1rem; margin: 0 0 1.75rem; max-width: 42ch; }

  /* Stage: the map fills a frame as tall as the screen; the side column and the strip of places
     float over it on white veils, so everything is visible without scrolling. */
  .stage { position: relative; height: calc(100dvh - var(--header-h) - 1rem); min-height: 32rem; max-height: 62rem; border-radius: 14px; overflow: hidden; background: var(--paper); box-shadow: 0 24px 60px -30px rgb(31 35 36 / 0.45); }
  .stage-map { position: absolute; inset: 0; }
  .stage::before { content: ''; position: absolute; pointer-events: none; z-index: 1; }
  .stage::before { inset: 0 auto 0 0; width: min(40rem, 62%); background: linear-gradient(90deg, rgb(255 255 255 / 0.97) 58%, rgb(255 255 255 / 0)); }
  .stage-side {
    position: absolute; z-index: 2; inset: 0 auto 0 0; width: min(28rem, 42%);
    padding: clamp(1.25rem, 3vh, 2.5rem) clamp(1.25rem, 3vw, 2.75rem); display: flex; flex-direction: column; gap: clamp(0.75rem, 2.2vh, 1.5rem);
    overflow-y: auto; scrollbar-width: thin;
  }
  #search .stage-side { width: min(32rem, 48%); justify-content: center; }
  .stage-strip { position: absolute; z-index: 2; left: min(28rem, 42%); right: 5.5rem; bottom: 1rem; }
  /* Loading: the stage shows once its blocks have answered. */
  .stage-loading { display: none; }
  .stage.is-loading .stage-loading { position: absolute; z-index: 4; inset: 0; display: grid; place-content: center; justify-items: center; gap: 1rem; background: var(--paper); color: var(--muted); text-align: center; padding: 1.5rem; }
  .stage.is-loading .stage-loading p { margin: 0; max-width: 30ch; }
  .stage.is-loading :is(.stage-map, .themes, .keys, .stage-strip) { visibility: hidden; }
  .loader { width: 36px; height: 36px; border-radius: 50%; border: 3px solid var(--line); border-top-color: var(--orange); }
  @media (prefers-reduced-motion: no-preference) { .loader { animation: spin 0.9s linear infinite; } @keyframes spin { to { transform: rotate(360deg); } } }

  /* Map */
  .map { overflow: hidden; background: #e9ebe8; }
  .map-tiles, .map-pins { position: absolute; inset: 0; }
  .map-tiles { filter: grayscale(1) contrast(0.92) brightness(1.07); }
  .map-tiles img { position: absolute; left: 0; top: 0; width: 256px; height: 256px; }
  .map-route { position: absolute; inset: 0; width: 100%; height: 100%; }
  .map-route polyline { fill: none; stroke: var(--orange); stroke-width: 4; stroke-linejoin: round; stroke-linecap: round; }
  .pin {
    position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 28px; height: 28px; margin: -14px 0 0 -14px; padding: 0;
    border-radius: 50%; background: var(--teal); color: #fff; border: 2px solid #fff; font: 700 0.68rem/1 var(--sans);
    box-shadow: 0 2px 6px rgb(31 35 36 / 0.3); cursor: pointer;
  }
  .pin.is-selected { background: var(--orange-ink); width: 34px; height: 34px; margin: -17px 0 0 -17px; z-index: 1; }
  .pin-main { width: 26px; height: 26px; margin: -13px 0 0 -13px; background: var(--orange); border: 5px solid #fff; box-shadow: 0 0 0 2px var(--orange), 0 4px 10px rgb(31 35 36 / 0.3); z-index: 2; cursor: default; }
  #home-map .pin { width: 20px; height: 20px; margin: -10px 0 0 -10px; background: var(--orange); }
  #home-map .pin:hover { transform-origin: center; outline: 3px solid rgb(232 112 42 / 0.35); }
  .map-controls { position: absolute; z-index: 3; right: 1.25rem; top: 50%; transform: translateY(-50%); display: grid; gap: 0.6rem; }
  .map-controls button { width: 44px; height: 44px; border: 0; border-radius: 8px; background: #fff; color: var(--ink); font: 500 1.35rem/1 var(--sans); cursor: pointer; box-shadow: 0 4px 14px rgb(31 35 36 / 0.18); }
  .map-controls .map-recenter { background: var(--orange); color: #fff; margin-bottom: 0.6rem; font-size: 1.5rem; }
  .map-credit { position: absolute; z-index: 3; right: 0.6rem; bottom: 0.35rem; margin: 0; font-size: 0.72rem; color: var(--muted); }

  /* Search */
  label { display: block; font-weight: 700; margin-bottom: 0.5rem; }
  .combo { position: relative; }
  #q { width: 100%; font: inherit; font-size: 1.1rem; padding: 0.9rem 1.1rem; border: 1.5px solid var(--ink); border-radius: 8px; background: #fff; color: var(--ink); }
  #q::placeholder { color: #707779; } /* 4.7:1 */
  #q:focus { outline: none; border-color: var(--orange-ink); box-shadow: 0 0 0 3px rgb(232 112 42 / 0.25); }
  [role='listbox'] { position: absolute; z-index: 5; left: 0; right: 0; top: calc(100% + 6px); margin: 0; padding: 0.35rem; list-style: none; background: #fff; border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 16px 32px rgb(31 35 36 / 0.16); }
  [role='option'] { padding: 0.6rem 0.8rem; border-radius: 8px; cursor: pointer; }
  [role='option']:hover, [role='option'][aria-selected='true'] { background: #f3efe9; }
  .help { color: var(--muted); font-size: 0.9rem; margin: 0.6rem 0 0; }
  .status:empty { display: none; }
  .status { margin: 0.75rem 0 0; font-weight: 700; }
  .example { margin-top: 1.5rem; color: var(--muted); }
  button.link { font: inherit; color: var(--orange-ink); background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; text-align: left; font-weight: 600; }

  /* Sheet: address and theme list */
  .address { font: 600 clamp(1.8rem, 3vw, 2.5rem)/1.05 var(--serif); margin: 0 0 0.4rem; }
  .address:focus { outline: none; }
  .meta { color: var(--muted); margin: 0; font-size: 0.92rem; }
  .themes .kicker { margin-bottom: 0.3rem; }
  .themes ul { list-style: none; margin: 0; padding: 0; }
  .themes-map ul { padding-left: 1rem; border-left: 2px solid var(--orange); display: grid; }
  .theme { font: 600 1.45rem/1.2 var(--serif); color: var(--muted); background: none; border: 0; padding: 0.2rem 0; cursor: pointer; text-align: left; }
  .theme:hover:not(:disabled) { color: var(--ink); }
  .theme:disabled { cursor: default; opacity: 0.55; }
  .theme sup { font: 600 0.8rem/1 var(--sans); margin-left: 0.3em; color: var(--orange-ink); }
  .theme.is-active { font-size: clamp(2rem, 4.2vh, 2.8rem); color: var(--ink); line-height: 1.05; position: relative; }
  .theme.is-active::before { content: ''; position: absolute; left: calc(-1rem - 5px); top: 50%; width: 8px; height: 8px; margin-top: -4px; border-radius: 50%; background: var(--orange); }
  .themes-more ul { display: flex; flex-wrap: wrap; gap: 0.2rem 0.9rem; }
  .theme-link { font-size: 0.92rem; color: var(--muted); }
  .theme-link:hover { color: var(--ink); }

  /* Bottom: key figures and the strip of places */
  .keys { display: grid; gap: 0.55rem; margin-top: auto; padding-top: 0.75rem; border-top: 1px solid var(--line); }
  .key { display: grid; text-decoration: none; }
  .key-value { font: 600 1.4rem/1.05 var(--serif); }
  .key-label { font-size: 0.8rem; color: var(--muted); }
  .key:hover .key-value { text-decoration: underline; }
  .strip-label { display: inline-block; font-variant: small-caps; letter-spacing: 0.08em; color: var(--ink); font-weight: 600; margin: 0 0 0.5rem; padding: 0.15rem 0.6rem; background: #fff; border-radius: 6px; box-shadow: 0 2px 8px rgb(31 35 36 / 0.12); }
  /* Whole cards only: the strip shows 1 to 4 cards depending on its width and scrolls card by card,
     with room around them so the selected outline and the shadows are never clipped. */
  .stage-strip { container-type: inline-size; }
  .strip-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; }
  .strip-nav { display: flex; gap: 0.4rem; margin-bottom: 0.5rem; }
  .strip-nav button { width: 36px; height: 36px; border: 0; border-radius: 8px; background: #fff; color: var(--ink); font: 500 1.4rem/1 var(--sans); cursor: pointer; box-shadow: 0 2px 8px rgb(31 35 36 / 0.12); }
  .strip-nav button:disabled { opacity: 0.4; cursor: default; }
  .strip { --n: 1; --gap: 1rem; list-style: none; margin: -8px; padding: 8px; display: flex; gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 8px; scrollbar-width: none; }
  .strip::-webkit-scrollbar { display: none; }
  .strip li { flex: 0 0 calc((100% - (var(--n) - 1) * var(--gap)) / var(--n)); scroll-snap-align: start; display: flex; }
  @container (min-width: 26rem) { .strip { --n: 2; } }
  @container (min-width: 42rem) { .strip { --n: 3; } }
  @container (min-width: 60rem) { .strip { --n: 4; } }
  .card { width: 100%; display: flex; gap: 0.8rem; align-items: flex-start; text-align: left; padding: 0.85rem 1rem; border: 1px solid var(--line); border-radius: 10px; background: #fff; color: var(--ink); font: inherit; cursor: pointer; box-shadow: 0 6px 18px rgb(31 35 36 / 0.16); }
  .card:hover { border-color: #b9c0bf; }
  .card.is-selected { border-color: var(--orange); box-shadow: 0 0 0 2px var(--orange), 0 10px 26px -14px rgb(31 35 36 / 0.5); }
  .badge { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--teal); color: #fff; font: 700 0.72rem/1 var(--sans); }
  .card.is-selected .badge { background: var(--orange-ink); }
  .card-body { display: grid; gap: 0.15rem; min-width: 0; }
  .card-body strong { font: 600 1.15rem/1.15 var(--serif); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .card-detail { font-size: 0.82rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .card-dist { font-size: 0.85rem; font-weight: 700; color: var(--orange-ink); }

  /* Details under the stage: one editorial row per theme, title and provenance on the left. */
  .details-title { font: 600 clamp(1.8rem, 3vw, 2.4rem)/1.1 var(--serif); margin: 3rem 0 0.5rem; }
  .blocks { display: grid; }
  .block { display: grid; grid-template-columns: minmax(12rem, 17rem) 1fr; gap: 1rem 3rem; padding: 2rem 0; border-top: 1px solid var(--line); scroll-margin-top: 1rem; }
  .block-head h2 { font: 600 1.9rem/1.05 var(--serif); margin: 0 0 0.6rem; }
  .provenance { display: grid; gap: 0.3rem; margin: 0; font-size: 0.82rem; color: var(--muted); }
  .block-body { min-width: 0; }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: 1.25rem 2rem; }
  .fact dt { font-variant: small-caps; letter-spacing: 0.05em; font-size: 0.9rem; color: var(--muted); font-weight: 600; }
  .fact dd { margin: 0.2rem 0 0; }
  .fact-value { display: block; font: 600 1.45rem/1.15 var(--serif); }
  .fact .detail { display: block; margin-top: 0.25rem; color: var(--muted); font-size: 0.88rem; }
  .explanation { margin: 1.25rem 0 0; color: var(--muted); max-width: 72ch; }
  .items { margin: 1.25rem 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: 0.1rem 2rem; }
  .items li { display: grid; padding: 0.5rem 0; border-bottom: 1px dotted var(--line); }
  .item-name { font-weight: 600; }
  .items .detail { color: var(--muted); font-size: 0.85rem; }
  .item-dist { font-size: 0.85rem; font-weight: 700; color: var(--orange-ink); }
  .notes { margin-top: 1rem; }
  .notes summary { cursor: pointer; font-size: 0.9rem; font-weight: 600; color: var(--muted); }
  .notes summary:hover { color: var(--ink); }
  .note { margin: 0.6rem 0 0; font-size: 0.88rem; color: var(--muted); padding-left: 0.75rem; border-left: 2px solid var(--orange); max-width: 72ch; }
  .error { margin: 0; color: var(--muted); }
  @media (max-width: 40rem) { .block { grid-template-columns: 1fr; padding: 1.5rem 0; } }
  .level-icon { display: inline-grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 0.35rem; margin-right: 0.45rem; border-radius: 999px; font-size: 0.78rem; font-weight: 800; vertical-align: 0.1em; }
  /* Colour doubles the icon and the hidden word, it never carries the meaning alone. */
  .level-ok .level-icon { background: #dcfce7; color: #14532d; }
  .level-info .level-icon { background: #e0f2f1; color: #134e48; }
  .level-warn .level-icon { background: #fef3c7; color: #78350f; }
  .level-alert .level-icon { background: #fee2e2; color: #7f1d1d; }
  .level-unknown .level-icon { background: #eef0ef; color: #3a4042; }
  .skeleton { display: grid; gap: 0.6rem; }
  .skeleton span { height: 0.9rem; border-radius: 999px; background: #eceeec; }
  .skeleton span:nth-child(2) { width: 70%; }
  .skeleton span:nth-child(3) { width: 45%; }
  @media (prefers-reduced-motion: no-preference) {
    .skeleton span { animation: pulse 1.4s ease-in-out infinite; }
    @keyframes pulse { 50% { opacity: 0.5; } }
    .card, .theme { transition: color 0.2s, border-color 0.2s, box-shadow 0.2s; }
  }

  /* Plain pages (sources) */
  main.prose { background: var(--paper); border-radius: 14px; padding: clamp(1.25rem, 3vw, 2.75rem); }
  main.prose h1 { font: 600 clamp(2rem, 4vw, 3rem)/1.05 var(--serif); }
  main.prose h2 { font: 600 1.8rem/1.1 var(--serif); }

  /* Narrow screens: no overlays. Address and map themes, then the map (never taller than half the
     screen), then the places strip right under it so it shows without scrolling. */
  @media (max-width: 56rem) {
    .stage { height: auto; min-height: 0; max-height: none; display: flex; flex-direction: column; }
    .stage::before { display: none; }
    .stage-side { display: contents; }
    .stage-head, .themes, .keys, #search .stage-side > * { padding: 0 1.1rem; }
    :root { --header-h: 3.25rem; }
    header.site { padding: 0 1rem; }
    .brand { font-size: 1.25rem; }
    header.site a:not(.brand) { font-size: 0.9rem; text-align: right; }
    .stage-head { order: 1; padding-top: 0.9rem; }
    .stage-head .kicker { margin-bottom: 0.3rem; }
    .address { font-size: 1.55rem; }
    .meta { font-size: 0.82rem; }
    .themes-map { order: 2; margin: 0.5rem 0; }
    .themes-map .kicker { display: none; }
    .theme { font-size: 1.15rem; }
    .stage-map { order: 3; position: relative; height: min(36dvh, 22rem); }
    .stage-strip { order: 4; position: static; padding: 0.75rem 1.1rem 0; }
    .keys { order: 5; margin: 1rem 0 0; border-top: 0; }
    .key { grid-template-columns: 1fr 1fr; align-items: baseline; gap: 0.75rem; border-bottom: 1px solid var(--line); padding-bottom: 0.5rem; }
    .key-value { order: 2; text-align: right; }
    .themes-more { order: 6; margin: 1rem 0 1.25rem; }
    #search .stage-side { display: block; width: 100%; padding: 1.25rem 0; }
    #search .stage-map { order: -1; }
    .themes-map ul { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 1rem; border-left: 0; padding: 0; }
    .theme.is-active { font-size: 1.6rem; }
    .theme.is-active::before { display: none; }
    .map-controls { top: auto; bottom: 1rem; transform: none; }
    .map-controls .map-recenter { margin-bottom: 0; }
    .map-controls { grid-auto-flow: column; }
  }
</style>

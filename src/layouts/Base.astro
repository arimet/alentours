---
import { url, absoluteUrl } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}
const SITE_NAME = 'Mon adresse en données';
const {
  title,
  description = 'Tapez une adresse en France : risques, eau du robinet, air, bruit, fibre, réseau mobile, prix de l’immobilier, écoles et santé, avec la source de chaque chiffre.',
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
// Directory-style URLs, as GitHub Pages serves them. Address sheets live in the #fragment,
// so they all share the home page's canonical URL and are never indexed, on purpose.
const canonical = absoluteUrl(Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length).replace(/\/?$/, '/'));
const image = absoluteUrl('/og.png');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mon adresse en données : les données publiques sur votre adresse, avec leurs sources." />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- GoatCounter: no cookie; it counts the path only, never the #fragment that holds the place. -->
    {import.meta.env.PROD && <script is:inline data-goatcounter="https://arimet.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>}
  </head>
  <body>
    <header class="site">
      <a href={url('/')} class="brand">Mon adresse en données</a>
      <a href={url('/sources/')}>Sources et méthodologie</a>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  /* Light only, as the plan asks. One accent, one 8px radius everywhere. */
  :root {
    --bg: #fafaf9;
    --surface: #ffffff;
    --ink: #1c1917;
    --muted: #57534e;   /* 7.3:1 on --bg */
    --line: #d6d3d1;
    --accent: #0f5f5c;  /* 7.6:1 on white */
    --accent-soft: #e6f0ef;
    --radius: 8px;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 1rem/1.55 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  a { color: var(--accent); }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  [hidden] { display: none !important; }

  header.site { padding: 1rem; max-width: 60rem; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between; }
  .brand { font-weight: 700; text-decoration: none; color: var(--ink); }
  main { padding: 0 1rem 4rem; max-width: 60rem; margin: 0 auto; }

  .search { padding-top: clamp(1.5rem, 8vh, 5rem); max-width: 40rem; }
  h1 { font-size: clamp(1.75rem, 5vw, 2.75rem); line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 0.75rem; }
  .lede { color: var(--muted); font-size: 1.125rem; margin: 0 0 2rem; max-width: 55ch; }

  label { display: block; font-weight: 600; margin-bottom: 0.5rem; }
  .combo { position: relative; }
  #q {
    width: 100%; font: inherit; font-size: 1.125rem; padding: 0.85rem 1rem;
    border: 2px solid var(--muted); border-radius: var(--radius); background: var(--surface); color: var(--ink);
  }
  #q::placeholder { color: #78716c; } /* 4.6:1 on white */
  #q:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px var(--accent-soft); }
  [role='listbox'] {
    position: absolute; z-index: 1; left: 0; right: 0; top: calc(100% + 4px);
    margin: 0; padding: 0.25rem; list-style: none;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 8px 24px rgb(28 25 23 / 0.08);
  }
  [role='option'] { padding: 0.6rem 0.75rem; border-radius: calc(var(--radius) - 2px); cursor: pointer; }
  [role='option']:hover, [role='option'][aria-selected='true'] { background: var(--accent-soft); }
  .help { color: var(--muted); font-size: 0.9rem; margin: 0.5rem 0 0; }
  .status:empty { display: none; }
  .status { margin: 0.75rem 0 0; font-weight: 600; }

  .example { margin-top: 2rem; color: var(--muted); }
  button.link {
    font: inherit; color: var(--accent); background: none; border: 0; padding: 0;
    text-decoration: underline; cursor: pointer; text-align: left;
  }

  .sheet { padding-top: 1rem; }
  .sheet h1:focus { outline: none; }
  .meta { color: var(--muted); margin: 0; }
  .map { margin: 1.25rem 0 0; }
  .map-tiles { position: relative; height: 220px; overflow: hidden; border-radius: var(--radius); border: 1px solid var(--line); background: #eeecea; }
  .map-tiles img { position: absolute; width: 256px; height: 256px; }
  .marker {
    position: absolute; left: 50%; top: 50%; width: 18px; height: 18px; margin: -9px 0 0 -9px;
    border-radius: 50%; background: var(--accent); border: 3px solid #fff; box-shadow: 0 0 0 2px var(--accent);
  }
  .map figcaption { font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .blocks { display: grid; gap: 1rem; margin-top: 2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
  .block { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; }
  .block h2 { font-size: 1.2rem; margin: 0 0 1rem; }
  .facts { margin: 0; display: grid; gap: 0.75rem; }
  .facts dt { font-size: 0.9rem; color: var(--muted); }
  .facts dd { margin: 0.1rem 0 0; }
  .facts .detail, .items .detail { display: block; color: var(--muted); font-size: 0.9rem; }
  .level-icon {
    display: inline-grid; place-items: center; min-width: 1.4rem; height: 1.4rem; padding: 0 0.3rem; margin-right: 0.4rem;
    border-radius: var(--radius); font-size: 0.8rem; font-weight: 700; vertical-align: 0.1em;
  }
  /* Colour doubles the icon and the hidden word, it never carries the meaning alone. */
  .level-ok .level-icon { background: #dcfce7; color: #14532d; }
  .level-info .level-icon { background: #e0f2fe; color: #0c4a6e; }
  .level-warn .level-icon { background: #fef3c7; color: #78350f; }
  .level-alert .level-icon { background: #fee2e2; color: #7f1d1d; }
  .level-unknown .level-icon { background: #f5f5f4; color: #44403c; }
  .explanation { margin: 1rem 0 0; }
  .items { margin: 1rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .note { margin: 0.75rem 0 0; font-size: 0.9rem; color: var(--muted); padding-left: 0.75rem; border-left: 3px solid var(--line); }
  .provenance { margin: 1rem 0 0; padding-top: 0.75rem; border-top: 1px solid var(--line); font-size: 0.85rem; color: var(--muted); }
  .error { margin: 0; color: var(--muted); }
  .skeleton { display: grid; gap: 0.6rem; }
  .skeleton span { height: 0.9rem; border-radius: var(--radius); background: #eeecea; }
  .skeleton span:nth-child(2) { width: 70%; }
  .skeleton span:nth-child(3) { width: 45%; }
  @media (prefers-reduced-motion: no-preference) {
    .skeleton span { animation: pulse 1.4s ease-in-out infinite; }
    @keyframes pulse { 50% { opacity: 0.5; } }
  }
</style>

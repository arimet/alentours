---
import { url, absoluteUrl } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}
const SITE_NAME = 'Mon adresse en données';
const {
  title,
  description = 'Tapez une adresse en France : risques, eau du robinet, air, bruit, fibre, réseau mobile, prix de l’immobilier, écoles et santé, avec la source de chaque chiffre.',
} = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
// Directory-style URLs, as GitHub Pages serves them. Address sheets live in the #fragment,
// so they all share the home page's canonical URL and are never indexed, on purpose.
const canonical = absoluteUrl(Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length).replace(/\/?$/, '/'));
const image = absoluteUrl('/og.png');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mon adresse en données : les données publiques sur votre adresse, avec leurs sources." />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- GoatCounter: no cookie; it counts the path only, never the #fragment that holds the place. -->
    {import.meta.env.PROD && <script is:inline data-goatcounter="https://arimet.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>}
  </head>
  <body>
    <header class="site">
      <a href={url('/')} class="brand">Mon adresse en données</a>
      <a href={url('/sources/')}>Sources et méthodologie</a>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  /* Light only, as the plan asks. Coral page, white panels on a navy shelf, navy pills.
     Radii: panels 28px, cards 16px, pills and inputs fully rounded or 12px. */
  :root {
    --page: #f07a78;
    --page-2: #f4a5a1;
    --panel: #ffffff;
    --ink: #1d1b33;
    --navy: #25233f;      /* pills, shelf; 15:1 on white */
    --muted: #55536a;     /* 7.4:1 on white */
    --line: #e7e4ea;
    --coral: #e9605f;
    --coral-deep: #b8373c; /* white text 5.6:1 */
    --focus: #25233f;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  html { background: var(--page); }
  body {
    margin: 0; min-height: 100dvh; color: var(--ink);
    background: linear-gradient(160deg, var(--page) 0%, var(--page-2) 100%) fixed;
    font: 1rem/1.55 'Helvetica Neue', Helvetica, Arial, system-ui, sans-serif;
  }
  a { color: var(--navy); }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  [hidden] { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  header.site { padding: 1.25rem 1rem; max-width: 76rem; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; justify-content: space-between; align-items: center; }
  header.site a { color: var(--ink); font-weight: 600; }
  .brand { font-weight: 800; font-size: 1.1rem; text-decoration: none; letter-spacing: -0.01em; }
  main { padding: 0 1rem 5rem; max-width: 76rem; margin: 0 auto; }

  /* Panel on its navy shelf, as in a device mock-up. */
  .panel { position: relative; background: var(--panel); border-radius: 28px; box-shadow: 0 30px 60px -20px rgb(90 20 30 / 0.35); isolation: isolate; }
  .panel::after {
    content: ''; position: absolute; z-index: -1; left: 3%; right: 3%; bottom: -18px; height: 60px;
    background: var(--navy); border-radius: 0 0 28px 28px;
  }
  .panel-map { height: clamp(260px, 44vh, 460px); border-radius: 28px 28px 0 0; border-bottom: 6px solid var(--coral); }
  .panel-body { padding: clamp(1.25rem, 3vw, 2.5rem); }

  .eyebrow { font-style: italic; color: var(--muted); font-size: 0.95rem; margin: 0 0 0.25rem; }
  h1 { font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 0.75rem; font-weight: 800; }
  .lede { color: var(--muted); font-size: 1.125rem; margin: 0 0 1.75rem; max-width: 55ch; }
  #search .panel-body { max-width: 46rem; }

  /* Map */
  .map { position: relative; overflow: hidden; background: #efece6; }
  .map-tiles, .map-pins { position: absolute; inset: 0; }
  .map-tiles img { position: absolute; left: 0; top: 0; width: 256px; height: 256px; }
  .pin {
    position: absolute; left: 0; top: 0; width: 26px; height: 26px; margin: -13px 0 0 -13px; padding: 0;
    border-radius: 50%; background: rgb(233 96 95 / 0.35); border: 2px solid var(--coral);
  }
  button.pin { width: 44px; height: 44px; margin: -22px 0 0 -22px; cursor: pointer; background: rgb(233 96 95 / 0.4); }
  button.pin:hover { background: rgb(233 96 95 / 0.65); }
  .pin-main { width: 22px; height: 22px; margin: -11px 0 0 -11px; background: var(--navy); border: 4px solid #fff; box-shadow: 0 0 0 2px var(--navy); z-index: 1; }
  .map-zoom {
    position: absolute; top: 1rem; right: 1rem; display: grid; background: #fff; border-radius: 12px;
    box-shadow: 0 6px 18px rgb(29 27 51 / 0.18); overflow: hidden;
  }
  .map-zoom button { width: 44px; height: 44px; border: 0; background: none; font: 600 1.3rem/1 inherit; color: var(--ink); cursor: pointer; }
  .map-zoom button + button { border-top: 1px solid var(--line); }
  .map-credit { position: absolute; right: 0.5rem; bottom: 0.3rem; margin: 0; font-size: 0.72rem; color: var(--ink); background: rgb(255 255 255 / 0.85); padding: 0 0.35rem; border-radius: 6px; }

  /* Search */
  label { display: block; font-weight: 700; margin-bottom: 0.5rem; }
  .combo { position: relative; }
  #q {
    width: 100%; font: inherit; font-size: 1.125rem; padding: 0.9rem 1.25rem;
    border: 2px solid var(--navy); border-radius: 999px; background: #fff; color: var(--ink);
  }
  #q::placeholder { color: #6e6c80; } /* 5:1 on white */
  #q:focus { outline: none; box-shadow: 0 0 0 4px rgb(37 35 63 / 0.18); }
  [role='listbox'] {
    position: absolute; z-index: 2; left: 0; right: 0; top: calc(100% + 6px); margin: 0; padding: 0.35rem; list-style: none;
    background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 16px 32px rgb(29 27 51 / 0.14);
  }
  [role='option'] { padding: 0.6rem 0.9rem; border-radius: 12px; cursor: pointer; }
  [role='option']:hover, [role='option'][aria-selected='true'] { background: #f3f1f6; }
  .help { color: var(--muted); font-size: 0.9rem; margin: 0.6rem 0 0 1.25rem; }
  .status:empty { display: none; }
  .status { margin: 0.75rem 0 0; font-weight: 700; }
  .example { margin-top: 1.75rem; color: var(--muted); }
  button.link { font: inherit; color: var(--navy); background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; text-align: left; font-weight: 600; }

  /* Pills */
  .pill {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0.4rem 1.1rem; border-radius: 999px;
    border: 2px solid var(--navy); background: #fff; color: var(--navy); font: 500 0.95rem/1.2 inherit; text-decoration: none; cursor: pointer; white-space: nowrap;
  }
  .pill[aria-pressed='true'] { background: var(--navy); color: #fff; }
  .pill:active { transform: translateY(1px); }
  .pills { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  /* Sheet */
  .sheet-head { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: flex-start; }
  #sheet-title { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  #sheet-title:focus { outline: none; }
  .meta { color: var(--muted); margin: 0; }
  .themes { margin-top: 1.75rem; }

  .keys { display: grid; gap: 1rem; margin-top: 1.75rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .key {
    display: grid; gap: 0.35rem; align-content: center; justify-items: center; text-align: center; min-height: 8.5rem; padding: 1rem 1.25rem;
    border-radius: 16px; text-decoration: none; color: var(--ink); box-shadow: 0 10px 22px -10px rgb(29 27 51 / 0.35);
  }
  .key:hover { transform: translateY(-2px); }
  .key-label { font-size: 0.95rem; }
  .key-value { font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.15; letter-spacing: -0.01em; }
  .key-grey { background: linear-gradient(135deg, #f4f3f5, #d9d7dc); }
  .key-yellow { background: linear-gradient(135deg, #fbd46d, #e5b84e); }
  .key-coral { background: linear-gradient(135deg, #c84346, #a8323a); color: #fff; }
  @media (prefers-reduced-motion: no-preference) { .key, .pill { transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1); } }

  /* Blocks */
  .blocks { display: grid; gap: 1.25rem; margin-top: 2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
  .block { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 1.35rem; box-shadow: 0 8px 20px -14px rgb(29 27 51 / 0.3); scroll-margin-top: 1rem; }
  .block h2 { font-size: 1.25rem; margin: 0 0 1rem; font-weight: 800; letter-spacing: -0.01em; }
  .facts { margin: 0; display: grid; gap: 0.8rem; }
  .facts dt { font-size: 0.9rem; font-style: italic; color: var(--muted); }
  .facts dd { margin: 0.1rem 0 0; }
  .facts dd strong { font-size: 1.05rem; }
  .facts .detail, .items .detail { display: block; color: var(--muted); font-size: 0.9rem; }
  .level-icon {
    display: inline-grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 0.35rem; margin-right: 0.45rem;
    border-radius: 999px; font-size: 0.78rem; font-weight: 800; vertical-align: 0.1em;
  }
  /* Colour doubles the icon and the hidden word, it never carries the meaning alone. */
  .level-ok .level-icon { background: #dcfce7; color: #14532d; }
  .level-info .level-icon { background: #e0e7ff; color: #312e81; }
  .level-warn .level-icon { background: #fef3c7; color: #78350f; }
  .level-alert .level-icon { background: #fee2e2; color: #7f1d1d; }
  .level-unknown .level-icon { background: #f1f0f3; color: #3f3d52; }
  .explanation { margin: 1rem 0 0; }
  .items { margin: 1rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.55rem; }
  .note { margin: 0.75rem 0 0; font-size: 0.9rem; color: var(--muted); padding-left: 0.75rem; border-left: 3px solid var(--coral); }
  .provenance { margin: 1rem 0 0; padding-top: 0.75rem; border-top: 1px solid var(--line); font-size: 0.85rem; color: var(--muted); }
  .error { margin: 0; color: var(--muted); }
  .skeleton { display: grid; gap: 0.6rem; }
  .skeleton span { height: 0.9rem; border-radius: 999px; background: #eeecf1; }
  .skeleton span:nth-child(2) { width: 70%; }
  .skeleton span:nth-child(3) { width: 45%; }
  @media (prefers-reduced-motion: no-preference) {
    .skeleton span { animation: pulse 1.4s ease-in-out infinite; }
    @keyframes pulse { 50% { opacity: 0.5; } }
  }

  /* Plain pages (sources) sit in the same white panel. */
  main.prose { background: var(--panel); border-radius: 28px; padding: clamp(1.25rem, 3vw, 2.5rem); box-shadow: 0 30px 60px -20px rgb(90 20 30 / 0.35); }
</style>

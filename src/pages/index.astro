---
import Base from '../layouts/Base.astro';
---
<Base>
  <main>
    <section id="search" class="stage">
      <div class="stage-map" id="home-map"></div>
      <div class="stage-side">
        <p class="kicker">Données publiques, sourcées</p>
        <h1 class="display">Ce que les données publiques disent de votre adresse</h1>
        <p class="lede">Risques, eau, air, fibre, réseau mobile, prix, écoles, santé et commerces. Chaque chiffre avec sa source.</p>

        <form id="search-form" role="search" autocomplete="off">
          <label for="q">Adresse en France</label>
          <div class="combo">
            <input id="q" type="text" inputmode="search" role="combobox" aria-autocomplete="list"
              aria-expanded="false" aria-controls="suggestions" aria-describedby="q-help q-status"
              placeholder="ex. 12 rue de la Gare, Rennes" spellcheck="false" />
            <ul id="suggestions" role="listbox" aria-label="Suggestions d’adresses" hidden></ul>
          </div>
          <p id="q-help" class="help">L’adresse est envoyée uniquement au service de géocodage de l’IGN, jamais à nous.</p>
          <p id="q-status" class="status" aria-live="polite"></p>
        </form>

        <p class="example">Essayer avec : <button type="button" id="example" class="link"></button></p>
      </div>
    </section>

    <section id="sheet" hidden aria-labelledby="sheet-title">
      <div class="stage">
        <div class="stage-map" id="sheet-map"></div>

        <div class="stage-side">
          <p class="kicker"><a href="#" id="back">← Nouvelle recherche</a></p>
          <h1 id="sheet-title" class="address" tabindex="-1"></h1>
          <p id="sheet-meta" class="meta"></p>
          <p id="sheet-status" class="status" aria-live="polite"></p>
          <nav id="themes" class="themes" aria-label="Thèmes" hidden></nav>
        </div>

        <div class="stage-bottom" id="stage-bottom" hidden>
          <div id="keys" class="keys"></div>
          <div class="strip-wrap">
            <p id="strip-label" class="strip-label"></p>
            <ul id="strip" class="strip" aria-labelledby="strip-label"></ul>
          </div>
        </div>
      </div>

      <h2 class="details-title">Tout le détail, source par source</h2>
      <div id="blocks" class="blocks"></div>
    </section>
  </main>
</Base>

<script>
  import './../scripts/app.ts';
</script>
